<Window x:Class="WorkplaceSaver.Views.SaveWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Workspace"
        Height="430" Width="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/WorkplaceSaver;component/Themes/Theme.xaml" />
    </Window.Resources>

    <!-- Raycast-Style Chiseled Modal Dialog with Top Specular Edge -->
    <Border Background="{StaticResource SurfaceOverlayBrush}"
            BorderBrush="{StaticResource BorderHairlineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" Opacity="0.75" Direction="270" ShadowDepth="8"/>
        </Border.Effect>

        <Grid>
            <!-- Inset top specular highlight -->
            <Border VerticalAlignment="Top" Height="1" Margin="14,0,14,0" Background="{StaticResource SpecularBorderGradient}" Panel.ZIndex="10"/>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Header -->
                    <RowDefinition Height="*" />    <!-- 1: Form Content -->
                    <RowDefinition Height="Auto" /> <!-- 2: Action Footer -->
                </Grid.RowDefinitions>

                <!-- 0. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icon Badge -->
                            <Border Background="{StaticResource PrimaryAccentGradient}"
                                    CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0"
                                    SnapsToDevicePixels="True">
                                <Path Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8V3"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Save Current Workspace"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Captures all open windows, screen positions, and layout"
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5"
                                   Margin="44,4,0,0" />
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource WindowChromeButtonStyle}"
                            Click="OnCancelClick"
                            VerticalAlignment="Top" />
                </Grid>

                <!-- 1. Form Content -->
                <StackPanel Grid.Row="1" Margin="0,2,0,16">
                    <!-- Detected Applications Preview -->
                    <Border Background="{StaticResource SurfaceRecessedBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="WINDOWS"
                                       FontFamily="{StaticResource AppFont}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <ItemsControl Grid.Column="1" x:Name="AppsPreviewList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="7,3"
                                                Margin="2,2"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Width="14" Height="14" Margin="0,0,5,0"
                                                       Source="{Binding AppIconBase64, Converter={StaticResource Base64ToImageConverter}}"
                                                       Visibility="{Binding AppIconBase64, Converter={StaticResource StringNotEmptyToVisConverter}}" />
                                                <TextBlock Text="{Binding ProcessName}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="11.5"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Workspace Name -->
                    <TextBlock Text="Workspace Name"
                               FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource DialogInputBoxStyle}"
                             Tag="e.g. Deep Work, Sprint Planning, Project Setup..."
                             Height="40"
                             Margin="0,0,0,14"
                             KeyDown="OnInputKeyDown" />

                    <!-- Tags / Categories -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="Tags"
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="— optional, comma-separated"
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="TagsTextBox"
                             Style="{StaticResource DialogInputBoxStyle}"
                             Tag="e.g. dev, design, personal"
                             Height="40"
                             KeyDown="OnInputKeyDown" />
                </StackPanel>

                <!-- 2. Actions Footer -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Keyboard Ergonomics Hint -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,5,0">
                            <TextBlock Text="Enter" FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="save" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="·" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,5,0">
                            <TextBlock Text="Esc" FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="cancel" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            Padding="16,0"
                            Margin="0,0,10,0"
                            Click="OnCancelClick" />

                    <Button Grid.Column="2"
                            Content="Save Workspace"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="36"
                            Padding="18,0"
                            Click="OnSaveClick" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
