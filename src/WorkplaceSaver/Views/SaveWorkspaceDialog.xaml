<Window x:Class="WorkplaceSaver.Views.SaveWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Workspace"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/Theme.xaml" />
    </Window.Resources>

    <!-- Dialog container with frosted glass border & drop shadow -->
    <Border Background="#161B22"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.6" Direction="270" ShadowDepth="6"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryAccentGradient}"
                                CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Save Current Workspace"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText"
                               Text="Captures all open windows, screen positions, and layout"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="42,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource DangerButtonStyle}"
                        FontSize="14"
                        Click="OnCancelClick"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="0,8,0,16">
                <!-- Detected Apps Preview -->
                <Border Background="#0D1117"
                        BorderBrush="#21262D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Detected Windows:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ItemsControl Grid.Column="1" x:Name="AppsPreviewList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#21262D"
                                            CornerRadius="6"
                                            Padding="6,3"
                                            Margin="3,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="14" Height="14" Margin="0,0,4,0"
                                                   Source="{Binding AppIconBase64, Converter={StaticResource Base64ToImageConverter}}"
                                                   Visibility="{Binding AppIconBase64, Converter={StaticResource StringNotEmptyToVisConverter}}" />
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Workspace Name -->
                <TextBlock Text="Workspace Name"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBox x:Name="NameTextBox"
                         Style="{StaticResource ModernSearchBoxStyle}"
                         Margin="0,0,0,14"
                         KeyDown="OnInputKeyDown" />

                <!-- Tags / Categories -->
                <TextBlock Text="Tags (optional, comma-separated)"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,6" />
                <TextBox x:Name="TagsTextBox"
                         Style="{StaticResource ModernSearchBoxStyle}"
                         KeyDown="OnInputKeyDown" />
            </StackPanel>

            <!-- Actions Footer -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Press Enter to save · Esc to cancel"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />

                <Button Grid.Column="2"
                        Content="Save Workspace"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnSaveClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
