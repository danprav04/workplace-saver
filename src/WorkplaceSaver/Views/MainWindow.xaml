<Window x:Class="WorkplaceSaver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkplaceSaver.ViewModels"
        xmlns:models="clr-namespace:WorkplaceSaver.Models"
        mc:Ignorable="d"
        Title="Workplace Saver"
        Height="720" Width="1080"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Window Container with Drop Shadow -->
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.5" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Window Chrome / Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Action & Search Bar -->
                <RowDefinition Height="Auto" /> <!-- Status Banner -->
                <RowDefinition Height="*" />    <!-- Main Content (Cards / Empty state) -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Window Chrome / Title Bar (Draggable) -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="14,14,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12"
                    MouseDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryAccentGradient}"
                                CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Workplace"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Saver"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center" />
                        <Border Background="#21262D" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="v1.0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Hotkey Badges in Title Bar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ctrl+Alt+S" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text=" Quick Save" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ctrl+Alt+W" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text=" Open Manager" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Controls (Minimize / Close to Tray) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="—"
                                Width="34" Height="30"
                                Padding="0"
                                Margin="0,0,6,0"
                                Click="OnMinimizeClick"
                                ToolTip="Minimize" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="✕"
                                Width="34" Height="30"
                                Padding="0"
                                Click="OnCloseClick"
                                ToolTip="Minimize to System Tray" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Controls & Search Bar -->
            <Border Grid.Row="1" Background="#11151C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0"
                             Style="{StaticResource ModernSearchBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,14,0"
                             Height="40" />

                    <!-- Sort Selection Dropdown -->
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedSort}"
                              Width="180"
                              Height="40"
                              Margin="0,0,14,0">
                        <ComboBoxItem Content="🕒 Newest First" Tag="date_desc" IsSelected="True"/>
                        <ComboBoxItem Content="📅 Oldest First" Tag="date_asc"/>
                        <ComboBoxItem Content="🔤 Name (A → Z)" Tag="name_asc"/>
                        <ComboBoxItem Content="🔤 Name (Z → A)" Tag="name_desc"/>
                        <ComboBoxItem Content="📦 Most Apps" Tag="apps_desc"/>
                    </ComboBox>

                    <!-- Capture Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CaptureCommand}"
                            Height="40"
                            Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📸" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Capture Current Workspace" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Status Notification Banner -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    BorderBrush="#38BDF8"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✨" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#F0F6FC"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Main Content (Workspaces Grid or Empty State) -->
            <Grid Grid.Row="3">
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasWorkspaces, Converter={StaticResource InverseBoolToVisConverter}}"
                            Margin="32">
                    <Border Background="#161B22"
                            BorderBrush="#30363D"
                            BorderThickness="1"
                            CornerRadius="24"
                            Width="88" Height="88"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">
                        <TextBlock Text="🖥️" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Saved Workspaces Yet"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Capture your current open windows and arrangements to restore them anytime."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               MaxWidth="420"
                               TextAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CaptureCommand}"
                            HorizontalAlignment="Center"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📸 Capture Workspace (Ctrl+Alt+S)" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cards List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,16"
                              Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Workspace}">
                                <!-- Workspace Card -->
                                <Border Width="320"
                                        Height="310"
                                        Margin="10"
                                        Background="{StaticResource CardBgBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.35" Direction="270" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130" /> <!-- Screenshot Thumbnail -->
                                            <RowDefinition Height="*" />   <!-- Info & Details -->
                                            <RowDefinition Height="Auto" /><!-- Actions -->
                                        </Grid.RowDefinitions>

                                        <!-- Card Screenshot Header -->
                                        <Border Grid.Row="0" CornerRadius="11,11,0,0" ClipToBounds="True" Background="#0D1117">
                                            <Grid>
                                                <!-- Image -->
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImageConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <!-- Gradient Overlay -->
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#22000000" Offset="0"/>
                                                            <GradientStop Color="#99161B22" Offset="0.8"/>
                                                            <GradientStop Color="#FF161B22" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- App Count Badge Top-Right -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="10"
                                                        Background="#B30D1117"
                                                        BorderBrush="#4058A6FF"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🪟 " FontSize="10" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding WindowCountSummary}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Relative Time Badge Top-Left -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="10"
                                                        Background="#B30D1117"
                                                        CornerRadius="6"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding RelativeTime}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10"
                                                               FontWeight="Medium"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Card Body -->
                                        <StackPanel Grid.Row="1" Margin="14,10,14,8">
                                            <!-- Workspace Title -->
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       Margin="0,0,0,3"/>

                                            <!-- Created date -->
                                            <TextBlock Text="{Binding CreatedAtFormatted}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,8"/>

                                            <!-- Mini App Icons Row -->
                                            <ItemsControl ItemsSource="{Binding DistinctAppIcons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#21262D"
                                                                BorderBrush="#30363D"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Width="24" Height="24"
                                                                Margin="0,0,5,0"
                                                                ToolTip="{Binding DisplayName}">
                                                            <Image Source="{Binding AppIconBase64, Converter={StaticResource Base64ToImageConverter}}"
                                                                   Width="16" Height="16"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Tags chips if present -->
                                            <ItemsControl ItemsSource="{Binding TagList}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1C2128"
                                                                BorderBrush="#30363D"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="5,2"
                                                                Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="10"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Card Actions Footer -->
                                        <Border Grid.Row="2"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Open / Restore Button -->
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="12,7"
                                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="▶ " FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Open Workspace" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="8,7"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete this saved workspace">
                                                    <TextBlock Text="🗑" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 5. Status / Info Footer -->
            <Border Grid.Row="4"
                    Background="#11151C"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0"/>
                        <TextBlock Text="Service Active · Press " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="Ctrl+Alt+S" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text=" to save workspace · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="Ctrl+Alt+W" Foreground="#A78BFA" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text=" to open manager" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Workplace Saver minimizes to the System Tray"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
