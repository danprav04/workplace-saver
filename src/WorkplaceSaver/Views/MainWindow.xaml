<Window x:Class="WorkplaceSaver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkplaceSaver.ViewModels"
        xmlns:models="clr-namespace:WorkplaceSaver.Models"
        mc:Ignorable="d"
        Title="Workplace Saver"
        Height="740" Width="1100"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorkplaceSaver;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Window Container with Deep Ambient Shadow & Specular Bevel -->
    <Border Background="{StaticResource CanvasBaseBrush}"
            BorderBrush="{StaticResource BorderHairlineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" Opacity="0.7" ShadowDepth="6" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Sleek Header / Title Bar -->
                <RowDefinition Height="Auto" /> <!-- 1: Command & Search Bar -->
                <RowDefinition Height="Auto" /> <!-- 2: Status Banner -->
                <RowDefinition Height="*" />    <!-- 3: Main Canvas (Workspaces / Empty State) -->
                <RowDefinition Height="Auto" /> <!-- 4: Status / Hotkey Footer -->
            </Grid.RowDefinitions>

            <!-- Inset top specular highlight for root window -->
            <Border Grid.Row="0" VerticalAlignment="Top" Height="1" Margin="14,0,14,0" Background="{StaticResource SpecularBorderGradient}" Panel.ZIndex="100"/>

            <!-- ================================================================= -->
            <!-- 0. SLEEK HEADER / TITLE BAR (Draggable)                           -->
            <!-- ================================================================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="13,13,0,0"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12"
                    MouseDown="OnTitleBarMouseDown"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Brand Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon glyph with specular glow -->
                        <Border Width="28" Height="28"
                                Background="{StaticResource PrimaryAccentGradient}"
                                CornerRadius="7"
                                Margin="0,0,10,0"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Workplace"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Saver"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentIndigoBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Version pill -->
                        <Border Background="#18191E"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="v1.0"
                                       FontFamily="{StaticResource CodeFont}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>

                    <!-- Tactile Hotkey Badges in Header -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <!-- Quick Save Badge -->
                        <Border Background="#121316"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,3"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+Alt+S"
                                           FontFamily="{StaticResource CodeFont}"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Save"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Open Manager Badge -->
                        <Border Background="#121316"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+Alt+W"
                                           FontFamily="{StaticResource CodeFont}"
                                           Foreground="{StaticResource AccentIndigoBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Manager"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize / Close to Tray) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowChromeButtonStyle}"
                                Content="—"
                                Margin="0,0,4,0"
                                Click="OnMinimizeClick"
                                ToolTip="Minimize window" />
                        <Button Style="{StaticResource WindowChromeButtonStyle}"
                                Content="✕"
                                Click="OnCloseClick"
                                ToolTip="Close (minimizes to system tray)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================= -->
            <!-- 1. ACTION & SEARCH TOOLBAR                                        -->
            <!-- ================================================================= -->
            <Border Grid.Row="1"
                    Background="#0B0C0E"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Command-style Search Input -->
                    <TextBox Grid.Column="0"
                             Style="{StaticResource ModernSearchBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,0"
                             Height="38" />

                    <!-- Sort Selection Dropdown -->
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedSort}"
                              Width="175"
                              Height="38"
                              Margin="0,0,12,0">
                        <ComboBoxItem Content="🕒 Newest First" Tag="date_desc" IsSelected="True"/>
                        <ComboBoxItem Content="📅 Oldest First" Tag="date_asc"/>
                        <ComboBoxItem Content="🔤 Name (A → Z)" Tag="name_asc"/>
                        <ComboBoxItem Content="🔤 Name (Z → A)" Tag="name_desc"/>
                        <ComboBoxItem Content="📦 Most Apps" Tag="apps_desc"/>
                    </ComboBox>

                    <!-- Tactile Capture Workspace Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CaptureCommand}"
                            Height="38"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📸" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Capture Workspace" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ================================================================= -->
            <!-- 2. STATUS NOTIFICATION BANNER                                     -->
            <!-- ================================================================= -->
            <Border Grid.Row="2"
                    Background="#111624"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentIndigoBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#5E6AD2" BlurRadius="6" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Medium"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ================================================================= -->
            <!-- 3. MAIN CANVAS (Cards Grid / Empty State)                         -->
            <!-- ================================================================= -->
            <Grid Grid.Row="3" Background="{StaticResource CanvasBaseBrush}">
                <!-- Empty State (Clean Engineered Minimalism) -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasWorkspaces, Converter={StaticResource InverseBoolToVisConverter}}"
                            Margin="40">
                    <!-- Subtle Glowing Icon Halo -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="76" Height="76"
                                CornerRadius="20"
                                Background="#141518"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <TextBlock Text="🖥️" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="No Saved Workspaces Yet"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Capture your current desktop arrangement of windows, states, and coordinates to instantly restore them anytime."
                               FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               MaxWidth="420"
                               TextAlignment="Center"
                               LineHeight="19"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CaptureCommand}"
                            HorizontalAlignment="Center"
                            Padding="18,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📸 Capture Workspace" FontWeight="SemiBold" FontSize="13"/>
                            <Border Background="#20FFFFFF" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                <TextBlock Text="Ctrl+Alt+S" FontFamily="{StaticResource CodeFont}" FontSize="10" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cards Grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,14"
                              Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Workspace}">
                                <!-- High-Density Tactile Workspace Card -->
                                <Border Width="330"
                                        Height="315"
                                        Margin="8"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.45" Direction="270" ShadowDepth="3"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="135" /> <!-- Screenshot Header -->
                                            <RowDefinition Height="*" />   <!-- Metadata & Content -->
                                            <RowDefinition Height="Auto" /><!-- Actions Footer -->
                                        </Grid.RowDefinitions>

                                        <!-- Top Specular Highlight Edge -->
                                        <Border Grid.Row="0" VerticalAlignment="Top" Height="1" Margin="10,0,10,0" Background="{StaticResource SpecularBorderGradient}" Panel.ZIndex="10"/>

                                        <!-- Card Screenshot Header with Seamless Fade -->
                                        <Border Grid.Row="0" CornerRadius="9,9,0,0" ClipToBounds="True" Background="#060708">
                                            <Grid>
                                                <!-- Desktop Preview Image -->
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImageConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                                <!-- Dark Surface Blend Gradient -->
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#80141518" Offset="0.7"/>
                                                            <GradientStop Color="#FF141518" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Relative Time Badge (Top-Left) -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="10"
                                                        Background="#D908090A"
                                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="7,3"
                                                        SnapsToDevicePixels="True">
                                                    <TextBlock Text="{Binding RelativeTime}"
                                                               FontFamily="{StaticResource AppFont}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10"
                                                               FontWeight="Medium"/>
                                                </Border>

                                                <!-- Window Count Badge (Top-Right) -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="10"
                                                        Background="#E608090A"
                                                        BorderBrush="{StaticResource BadgeCyanBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="7,3"
                                                        SnapsToDevicePixels="True">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🪟 " FontSize="9" Foreground="{StaticResource AccentCyanBrush}"/>
                                                        <TextBlock Text="{Binding WindowCountSummary}"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Card Details Body -->
                                        <StackPanel Grid.Row="1" Margin="14,8,14,8">
                                            <!-- Workspace Title -->
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       Margin="0,0,0,2"/>

                                            <!-- Created Date (Muted tabular) -->
                                            <TextBlock Text="{Binding CreatedAtFormatted}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,8"/>

                                            <!-- App Icons Badges Row -->
                                            <ItemsControl ItemsSource="{Binding DistinctAppIcons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Width="24" Height="24"
                                                                Margin="0,0,5,0"
                                                                ToolTip="{Binding DisplayName}"
                                                                SnapsToDevicePixels="True">
                                                            <Image Source="{Binding AppIconBase64, Converter={StaticResource Base64ToImageConverter}}"
                                                                   Width="15" Height="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Tag Chips (if present) -->
                                            <ItemsControl ItemsSource="{Binding TagList}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#16171B"
                                                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,4,4"
                                                                SnapsToDevicePixels="True">
                                                            <TextBlock Text="{Binding}"
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="10"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Card Actions Footer -->
                                        <Border Grid.Row="2"
                                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Open Workspace Button -->
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="12,6"
                                                        Height="32"
                                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="▶ " FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Open Workspace" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="8,4"
                                                        Height="32"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete this saved workspace">
                                                    <TextBlock Text="🗑" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ================================================================= -->
            <!-- 4. STATUS / HOTKEY FOOTER                                         -->
            <!-- ================================================================= -->
            <Border Grid.Row="4"
                    Background="{StaticResource HeaderGradient}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13"
                    Padding="18,10"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Active Status Dot with Ambient Glow -->
                        <Border Background="{StaticResource AccentGreenBrush}"
                                CornerRadius="3"
                                Width="6" Height="6"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="6" Opacity="0.8" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>

                        <TextBlock Text="Service Active"
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" · Press "
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Border Background="#16171B" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="2,0">
                            <TextBlock Text="Ctrl+Alt+S" FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text=" to save · "
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Border Background="#16171B" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="2,0">
                            <TextBlock Text="Ctrl+Alt+W" FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource AccentIndigoBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text=" to open manager"
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Minimizes to System Tray"
                               FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
