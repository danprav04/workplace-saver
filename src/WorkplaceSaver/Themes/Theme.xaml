<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:WorkplaceSaver.Converters">

    <!-- Value Converters -->
    <conv:Base64ToImageConverter x:Key="Base64ToImageConverter" />
    <conv:FilePathToImageConverter x:Key="FilePathToImageConverter" />
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter" />

    <!-- ================================================================= -->
    <!--  1. MODERN SLICK COLOR PALETTE (OBSIDIAN / ZINC SURFACE LADDER)   -->
    <!-- ================================================================= -->

    <!-- Surfaces (Never Pure Black) -->
    <Color x:Key="CanvasBaseColor">#08090A</Color>       <!-- Deepest root window canvas -->
    <Color x:Key="SurfaceRecessedColor">#050506</Color>   <!-- Inset inputs, search field -->
    <Color x:Key="SurfaceSubtleColor">#0F1012</Color>     <!-- Window header, toolbars, footer -->
    <Color x:Key="SurfaceCardColor">#141518</Color>       <!-- Standard elevated cards -->
    <Color x:Key="SurfaceRaisedColor">#1A1B1F</Color>     <!-- Hovered cards, secondary buttons -->
    <Color x:Key="SurfaceOverlayColor">#1E2026</Color>    <!-- Modals, dialogs, flyouts -->
    <Color x:Key="SurfaceActiveColor">#262830</Color>     <!-- Pressed states, selected rows -->

    <!-- Legacy compatibility aliases -->
    <Color x:Key="BgColor">#08090A</Color>
    <Color x:Key="HeaderBgColor">#0F1012</Color>
    <Color x:Key="CardBgColor">#141518</Color>
    <Color x:Key="CardBgHoverColor">#1A1B1F</Color>

    <!-- Hairline Specular Borders -->
    <Color x:Key="BorderHairlineColor">#14FFFFFF</Color> <!-- 8% white hairline -->
    <Color x:Key="BorderMediumColor">#22FFFFFF</Color>   <!-- 13% white edge -->
    <Color x:Key="BorderActiveColor">#38FFFFFF</Color>   <!-- 22% white highlight -->
    <Color x:Key="BorderColor">#1FFFFFFF</Color>         <!-- Default border -->
    <Color x:Key="BorderHoverColor">#5E6AD2</Color>      <!-- Accent focus / hover border -->

    <!-- High-Contrast Text Hierarchy (WCAG AAA) -->
    <Color x:Key="TextPrimaryColor">#EDEDED</Color>      <!-- 14:1+ contrast on dark -->
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>    <!-- Zinc-400 for descriptions -->
    <Color x:Key="TextMutedColor">#71717A</Color>        <!-- Zinc-500 for micro-labels -->
    <Color x:Key="TextDisabledColor">#52525B</Color>     <!-- Zinc-600 for placeholders -->

    <!-- Chromatic Accents (Linear Indigo & Status) -->
    <Color x:Key="AccentIndigo">#5E6AD2</Color>
    <Color x:Key="AccentIndigoHover">#6E7BE2</Color>
    <Color x:Key="AccentIndigoGlow">#805E6AD2</Color>
    <Color x:Key="AccentCyan">#38BDF8</Color>
    <Color x:Key="AccentGreen">#10B981</Color>
    <Color x:Key="AccentAmber">#F59E0B</Color>
    <Color x:Key="AccentRed">#EF4444</Color>
    <Color x:Key="AccentRedHover">#DC2626</Color>

    <!-- ================================================================= -->
    <!--  2. SOLID & GRADIENT BRUSHES                                      -->
    <!-- ================================================================= -->

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRecessedBrush" Color="{StaticResource SurfaceRecessedColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource SurfaceSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}" />

    <SolidColorBrush x:Key="BorderHairlineBrush" Color="{StaticResource BorderHairlineColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource BorderActiveColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderHairlineColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigo}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />

    <!-- Luminous Soft Badge Fills -->
    <SolidColorBrush x:Key="BadgeIndigoBgBrush" Color="#1F5E6AD2" />
    <SolidColorBrush x:Key="BadgeIndigoBorderBrush" Color="#4D5E6AD2" />
    <SolidColorBrush x:Key="BadgeCyanBgBrush" Color="#1F38BDF8" />
    <SolidColorBrush x:Key="BadgeCyanBorderBrush" Color="#4D38BDF8" />
    <SolidColorBrush x:Key="BadgeGreenBgBrush" Color="#1F10B981" />
    <SolidColorBrush x:Key="BadgeGreenBorderBrush" Color="#4D10B981" />

    <!-- Specular Light Gradients -->
    <LinearGradientBrush x:Key="PrimaryAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5E6AD2" Offset="0" />
        <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HoverAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6E7BE2" Offset="0" />
        <GradientStop Color="#6366F1" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0F1012" Offset="0" />
        <GradientStop Color="#121316" Offset="1" />
    </LinearGradientBrush>

    <!-- Top Specular Bevel (Light hitting the top edge) -->
    <LinearGradientBrush x:Key="SpecularBorderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2AFFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardTopHighlightGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.15" />
    </LinearGradientBrush>

    <!-- ================================================================= -->
    <!--  3. TYPOGRAPHY                                                    -->
    <!-- ================================================================= -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Inter, -apple-system, BlinkMacSystemFont, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Code, Segoe UI Mono, Consolas, monospace</FontFamily>

    <!-- ================================================================= -->
    <!--  4. MINIMALIST SLICK SCROLLBAR                                    -->
    <!-- ================================================================= -->

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="thumbBorder"
                                                    CornerRadius="3"
                                                    Background="#262830"
                                                    Margin="1,0"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBorder" Property="Background" Value="#3F434D" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumbBorder" Property="Background" Value="#5E6AD2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!--  5. BUTTON STYLES                                                 -->
    <!-- ================================================================= -->

    <!-- Primary Tactile Button (Linear Indigo with Specular Top Line) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource PrimaryAccentGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Specular glow underlay -->
                        <Border x:Name="glow"
                                CornerRadius="8"
                                Background="#5E6AD2"
                                Opacity="0.25">
                            <Border.Effect>
                                <DropShadowEffect Color="#5E6AD2" BlurRadius="12" Opacity="0.4" ShadowDepth="2" Direction="270" />
                            </Border.Effect>
                        </Border>

                        <!-- Main button surface -->
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Inset top specular highlight -->
                                <Border VerticalAlignment="Top" Height="1" Margin="1,0,1,0" Background="#40FFFFFF" CornerRadius="1" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource HoverAccentGradient}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF" />
                            <Setter TargetName="glow" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            <Setter TargetName="glow" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            <Setter TargetName="glow" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Tactile Button (Chiseled Charcoal with Hairline Border) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Inset top specular line -->
                            <Border VerticalAlignment="Top" Height="1" Margin="1,0,1,0" Background="#1FFFFFFF" CornerRadius="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#22242B" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#17181C" />
                            <Setter TargetName="border" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button (Subtle Red Accent) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#F87171" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2A1418" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#4DEF4444" />
                            <Setter Property="Foreground" Value="#FCA5A5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3B171D" />
                            <Setter TargetName="border" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost Icon / Window Chrome Button -->
    <Style x:Key="WindowChromeButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1C1E24" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#252730" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!--  6. MODERN COMMAND-BAR SEARCH INPUT BOX                           -->
    <!-- ================================================================= -->

    <Style x:Key="ModernSearchBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentIndigoBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRecessedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Inset Search Glyph -->
                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,6,0" />

                            <!-- Text Input Area -->
                            <ScrollViewer Grid.Column="1"
                                          x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Margin="2,0,8,0" />

                            <!-- Placeholder Watermark -->
                            <TextBlock Grid.Column="1"
                                       Text="Search workspaces by name, app or tags..."
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Shortcut hint pill (Ctrl+F) -->
                            <Border Grid.Column="2"
                                    Background="#141518"
                                    BorderBrush="{StaticResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Ctrl+F"
                                           FontFamily="{StaticResource CodeFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}" />
                            <Setter TargetName="border" Property="Background" Value="#0A0B0E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Input Field (Used in Dialogs) -->
    <Style x:Key="DialogInputBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentIndigoBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRecessedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}" />
                            <Setter TargetName="border" Property="Background" Value="#0B0C0E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!--  7. MODERN COMBOBOX STYLE                                         -->
    <!-- ================================================================= -->

    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center" />
                                <Path Grid.Column="1"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="8,0,2,0" />
                            </Grid>
                        </Border>
                        <ToggleButton Grid.ColumnSpan="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               Focusable="False">
                            <Border x:Name="DropDown"
                                    Background="{StaticResource SurfaceOverlayBrush}"
                                    BorderBrush="{StaticResource BorderMediumBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.6" Direction="270" ShadowDepth="4" />
                                </Border.Effect>
                                <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
                            <Setter TargetName="Border" Property="Background" Value="#22242B" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentIndigoBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
